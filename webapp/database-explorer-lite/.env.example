# Optional generation path overrides.
# Defaults (if unset):
# MOLCRAFT_MODELS_DIR=<repo>/models
# MOLCRAFT_OUTPUTS_DIR=<repo>/outputs
# MOLCRAFT_PRESETS_DIR=<repo>/presets
# MOLCRAFT_PREDICT_MODELS_DIR=<repo>/models/predictive_model
# MOLCRAFT_PREDICT_CONFIG=<repo>/predict.yaml

MOLCRAFT_MODELS_DIR=/absolute/path/to/molviz/models
MOLCRAFT_OUTPUTS_DIR=/absolute/path/to/molviz/outputs
MOLCRAFT_PRESETS_DIR=/absolute/path/to/molviz/presets
MOLCRAFT_PREDICT_MODELS_DIR=/absolute/path/to/molviz/models/predictive_model
MOLCRAFT_PREDICT_CONFIG=/absolute/path/to/molviz/predict.yaml
